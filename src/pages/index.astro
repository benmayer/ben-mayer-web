---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import apps from '../assets/apps.png';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.slice(0, 2);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base
  title="Ben Mayer"
  description="Developer and product manager showcasing app projects and case studies."
>
  <section class="hero">
    <Image src={apps} alt="" width={748} class="hero-apps pulse animated" />
    <h1>Hi, I'm Ben.</h1>
    <p>
      I love building apps and websites and have 20 odd years of experience as{' '}
      <span>Designer</span>, <span>Developer</span> and <span>Product Manager</span>.
    </p>
    <div class="hero-links">
      <a href="#work">My Work</a>
      <a href="mailto:hi@ben-mayer.com">Get in touch</a>
    </div>
  </section>

  <hr class="hero-divider" />

  <section id="work" class="project-rows work-teaser">
    <h2>Work</h2>
    {featuredProjects.map((project, i) => <ProjectCard project={project} reverse={i % 2 === 1} />)}
  </section>

  <div class="container">
    <section class="blog-teaser">
      <h2>Thoughts...</h2>
      <ul class="blog-list">
        {
          latestPosts.map((post) => (
            <li>
              <a class="blog-item" href={`/blog/${post.id}/`}>
                <Image
                  src={post.data.coverImage}
                  alt={post.data.coverImageAlt}
                  width={300}
                  height={200}
                />
                <div class="blog-item-body">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-GB', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    })}
                  </time>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="blog-teaser-links" href="/blog">View all posts &rarr;</a>
    </section>
  </div>
</Base>
