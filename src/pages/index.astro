---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import apps from '../assets/apps.png';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base
  title="Ben Mayer"
  description="Developer and product manager showcasing app projects and case studies."
>
  <section class="hero home-hero">
    <Image src={apps} alt="" width={748} class="hero-apps" />
    <h1>Hi, I'm Ben.</h1>
    <p>I love building apps and websites</p>
    <a class="button" href="mailto:ben.lukas.mayer@gmail.com">Get in touch</a>
  </section>

  <section id="projects" class="project-rows">
    <h2 class="sr-only">Projects</h2>
    {
      projects.map((project, i) => (
        <div class:list={['project-band', { alt: i % 2 === 1 }]}>
          <div class:list={['project-row', { reverse: i % 2 === 1 }]}>
            <div class="project-row-media">
              <Image
                src={project.data.coverImage}
                alt={project.data.coverImageAlt}
                width={600}
              />
            </div>
            <div class="project-row-body">
              {project.data.icon && (
                <div class="project-icon">
                  <Image src={project.data.icon} alt="" width={88} densities={[1, 2, 3]} />
                </div>
              )}
              <h3 class="project-title">{project.data.title}</h3>
              <h4 class="project-subtitle">{project.data.subtitle}</h4>
              <p class="project-summary">{project.data.summary}</p>
              <div class="project-row-links">
                <a href={`/projects/${project.id}/`}>Read more</a>
                {project.data.links?.appstore && (
                  <a href={project.data.links.appstore}>Appstore</a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <div class="container">
    <section class="blog-teaser">
      <h2>Thoughts...</h2>
      {
        latestPosts.map((post) => (
          <>
            <hr />
            <div class="blog-teaser-row">
              <a class="blog-teaser-thumb" href={`/blog/${post.id}/`}>
                <Image
                  src={post.data.coverImage}
                  alt={post.data.coverImageAlt}
                  width={200}
                  height={200}
                />
              </a>
              <div class="blog-teaser-body">
                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
                <div class="blog-teaser-links">
                  <a href={`/blog/${post.id}/`}>Read more</a>
                </div>
              </div>
            </div>
          </>
        ))
      }
      <hr />
    </section>
  </div>
</Base>
