---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog" description="Things I've learnt and thoughts I've thought.">
  <div class="container">
    <section class="hero">
      <h1>Blog</h1>
      <p>Things I've learnt and thoughts I've thought.</p>
    </section>

    <ul class="blog-list">
      {
        posts.map((post) => (
          <li>
            <a class="blog-item" href={`/blog/${post.id}/`}>
              <Image src={post.data.coverImage} alt={post.data.coverImageAlt} width={300} height={200} />
              <div class="blog-item-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-item {
    display: flex;
    gap: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    color: inherit;
  }

  .blog-item:hover {
    box-shadow: 0 4px 16px rgb(0 0 0 / 8%);
    text-decoration: none;
  }

  .blog-item img {
    width: 220px;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .blog-item-body {
    padding: 1.25rem 1.25rem 1.25rem 0;
  }

  .blog-item-body h3 {
    margin: 0 0 0.5rem;
  }

  .blog-item-body p {
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }

  .blog-item-body time {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
