---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog" description="Things I've learnt and thoughts I've thought.">
  <div class="container">
    <section class="hero">
      <h1>Blog</h1>
      <p>Things I've learnt and thoughts I've thought.</p>
    </section>

    <ul class="blog-list">
      {
        posts.map((post) => (
          <li>
            <a class="blog-item" href={`/blog/${post.id}/`}>
              <Image src={post.data.coverImage} alt={post.data.coverImageAlt} width={300} height={200} />
              <div class="blog-item-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
