---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={data.title} description={data.summary}>
  <div class="container">
    <header class="case-study-header">
      <div class="project-header-row">
        <div class="project-header-media">
          <Image src={data.coverImage} alt={data.coverImageAlt} width={720} />
        </div>
        <div class="project-header-content">
          {
            data.stack.length > 0 && (
              <ul class="chip-list">
                {data.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            )
          }

          <div class="project-title-group">
          <h1 class="project-title">{data.title}</h1>
          {data.subtitle && <h2 class="project-subtitle">{data.subtitle}</h2>}
          <p class="project-summary">{data.summary}</p>
          </div>

          {
            data.details && data.details.length > 0 && (
              <dl class="project-details">
                {data.details.map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            data.links && (
              <p class="project-links-line">
                {data.links.live && <a href={data.links.live}>Website</a>}
                {data.links.appstore && (
                  <>
                    {' '}
                    &bull; <a href={data.links.appstore}>AppStore</a>
                  </>
                )}
                {data.links.playstore && (
                  <>
                    {' '}
                    &bull; <a href={data.links.playstore}>PlayStore</a>
                  </>
                )}
                {data.links.demo && (
                  <>
                    {' '}
                    &bull; <a href={data.links.demo}>Demo</a>
                  </>
                )}
                {data.links.repo && (
                  <>
                    {' '}
                    &bull; <a href={data.links.repo}>Source code</a>
                  </>
                )}
              </p>
            )
          }
        </div>
      </div>
    </header>

    <article class="case-study-body">
      <Content />
    </article>
  </div>
</Base>
