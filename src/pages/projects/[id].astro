---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const roleLabel: Record<string, string> = {
  developer: 'Developer',
  'product-manager': 'Product Manager',
  both: 'Developer & PM',
};
---

<Base title={data.title} description={data.summary}>
  <div class="container">
    <a class="back-link" href="/">&larr; Back to all projects</a>

    <header class="case-study-header">
      <span class="tag">{roleLabel[data.role]}</span>
      <h1>{data.title}</h1>
      <p>{data.summary}</p>
      <ul class="chip-list">
        {data.stack.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </header>

    <div class="case-study-cover">
      <Image src={data.coverImage} alt={data.coverImageAlt} width={1200} height={750} />
    </div>

    {
      data.links && (
        <div class="case-study-links">
          {data.links.live && <a href={data.links.live}>Live site</a>}
          {data.links.demo && <a href={data.links.demo}>Demo</a>}
          {data.links.repo && <a href={data.links.repo}>Source code</a>}
        </div>
      )
    }

    <article class="case-study-body">
      <Content />
    </article>

    {
      data.gallery && data.gallery.length > 0 && (
        <section class="case-study-gallery">
          {data.gallery.map((item) => (
            <Image src={item.image} alt={item.alt} width={1200} height={750} />
          ))}
        </section>
      )
    }
  </div>
</Base>
